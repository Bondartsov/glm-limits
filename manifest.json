{
  "manifest_version": 3,
  "name": "GLM Mochi — GLM Limits",
  "version": "0.1.0",
  "description": "Show your GLM Coding Plan session (5h) and weekly usage at a glance.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://open.bigmodel.cn/*",
    "https://api.z.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GLM Mochi Limits",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}